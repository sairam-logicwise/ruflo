{
  "$ref": "#/definitions/task",
  "definitions": {
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TASK-\\d+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/recordId"
          },
          "minItems": 1,
          "contains": {
            "pattern": "^(REQ|DEC)-\\d+$"
          }
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "human",
            "agent-inferred"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "backlog",
            "active",
            "blocked",
            "done"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/recordId"
          },
          "default": []
        },
        "estimate": {
          "type": "object",
          "properties": {
            "lowTokens": {
              "type": "number",
              "minimum": 0
            },
            "highTokens": {
              "type": "number",
              "minimum": 0
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "lowTokens",
            "highTokens",
            "confidence"
          ],
          "additionalProperties": false
        },
        "actuals": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": "number",
              "minimum": 0
            },
            "outputTokens": {
              "type": "number",
              "minimum": 0
            },
            "costUsd": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "inputTokens",
            "outputTokens",
            "costUsd"
          ],
          "additionalProperties": false
        },
        "doneCriteria": {
          "type": "object",
          "properties": {
            "testLayers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "unit",
                  "integration",
                  "e2e",
                  "automation"
                ]
              },
              "default": []
            },
            "coverageThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "title",
        "createdAt",
        "updatedAt",
        "citations",
        "contentHash",
        "provenance",
        "status",
        "priority"
      ],
      "additionalProperties": false
    },
    "recordId": {
      "type": "string",
      "pattern": "^(REQ|DEC|TASK)-\\d+$"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
